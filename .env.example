# Copy to .env next to docker-compose.yml and fill in.

# GitHub account or org the image is published under; the image is
# ghcr.io/$GHCR_OWNER/sequent. Lowercase — GHCR rejects capitals.
GHCR_OWNER=your-github-username

# The hostname Traefik should route to this container.
SEQUENT_DOMAIN=sequent.example.com

# Pin to a release tag rather than `latest` if you would rather redeploys be
# deliberate: SEQUENT_TAG=v0.1.0
SEQUENT_TAG=latest

# Must match the existing Traefik setup.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
