# Copy to .env next to docker-compose.yml and fill in.

# The image is hardcoded to ghcr.io/dyslectric/sequent in docker-compose.yml.

# The hostname Traefik should route to this container.
SEQUENT_DOMAIN=sequent.example.com

# Pin to a release tag rather than `latest` if you would rather redeploys be
# deliberate: SEQUENT_TAG=v0.1.0
SEQUENT_TAG=latest

# Must match the existing Traefik setup.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
