* text=auto

# These run on Linux. CRLF makes the shebang line fail with a bad-interpreter
# error, so pin them regardless of the platform they were edited on.
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf

# Never line-ending-converted.
*.png binary
*.ico binary
*.icns binary
*.woff2 binary
